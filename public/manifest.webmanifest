{
  "id": "/",
  "name": "SAIYAD PHOTO",
  "short_name": "SAIYAD PHOTO",
  "description": "Professional 4x6 Passport Photo Studio app for high-resolution 300 DPI print sheets, custom passport sizes, and instant photo export.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay"
  ],
  "orientation": "portrait",
  "background_color": "#eef2f5",
  "theme_color": "#0f172a",
  "categories": [
    "photo",
    "photography",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "SAIYAD PHOTO Mobile Studio"
    },
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "SAIYAD PHOTO 4x6 Print Studio"
    }
  ],
  "shortcuts": [
    {
      "name": "New 4x6 Sheet",
      "short_name": "New Sheet",
      "description": "Create a new 4x6 passport photo print sheet",
      "url": "/",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
